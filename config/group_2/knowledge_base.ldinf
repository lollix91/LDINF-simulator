# Regole di inferenza per il gruppo 2 (Organizzazione Evento)
# Il gruppo 2 organizza un evento ma ha bisogno di aiuto per cucinare
has(decorations) & has(venue) -> done(decorate_venue)
done(decorate_venue) & done(cook_main_dish) -> done(organize_event)

# EQUIVALENZE
equiv(cook_main_dish, cook_pasta)
equiv(cook_main_dish, cook_steak)

# COSTI - Il gruppo 2 sa decorare ma NON sa cucinare (non ha costi per cook_*)
cost(decorate_venue, ENERGY:3, decorations:1, venue:0)

# Costo base per ragionare
inference_cost(2)

# PREFERENZE
pref(decorate_venue, 8)
